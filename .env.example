# Supabase project REST URL, e.g. https://xxxx.supabase.co — unset locally to use the JSON file dev store
SUPABASE_URL=
# Supabase service role key — server only, must never be prefixed NEXT_PUBLIC_ or reach the client
SUPABASE_SERVICE_ROLE_KEY=
# /admin login uses Supabase Auth: create the user in Authentication → Users, then grant it
#   update auth.users set raw_app_meta_data = raw_app_meta_data || '{"role":"admin"}' where email = '...';
# Local dev without Supabase: any email + "1234"
