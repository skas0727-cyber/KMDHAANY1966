# Supabase project REST URL, e.g. https://xxxx.supabase.co — unset locally to use the JSON file dev store
SUPABASE_URL=
# Supabase service role key — server only, must never be prefixed NEXT_PUBLIC_ or reach the client
SUPABASE_SERVICE_ROLE_KEY=
# /admin login uses Supabase Auth: every user in Authentication → Users can log in
# (keep "Allow new users to sign up" off). Local dev without Supabase: any email + "1234"
# Google Search Console → 설정 → 소유권 확인 → HTML 태그의 content 값 (예: AbC123...). 비우면 태그가 출력되지 않음
GOOGLE_SITE_VERIFICATION=
